@prefix : <https://example.com/decision-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

:OracleBridgeOntology a owl:Ontology ;
    rdfs:label "Oracle Bridge Ontology" ;
    rdfs:comment "Bridge ontology linking OCI discovery, stakeholder positioning, Oracle semantic runtime, and deployment concerns." ;
    owl:versionInfo "0.1.0" ;
    dct:created "2026-04-06"^^xsd:date ;
    owl:imports <./decision-core-core.ttl>,
        <./oracle-discovery-adjacency-map.ttl> .

:BridgeAssertion a owl:Class ;
    rdfs:label "Bridge Assertion" ;
    rdfs:comment "A typed assertion connecting Oracle discovery, runtime, deployment, and stakeholder layers." .

:BusinessGap a owl:Class ;
    rdfs:label "Business Gap" ;
    rdfs:comment "A missing Oracle business-application domain that is implied but not yet modeled." .

:bridgesArtifact a owl:ObjectProperty ;
    rdfs:label "bridges artifact" ;
    rdfs:domain :BridgeAssertion ;
    rdfs:range :OntologyArtifact .

:bridgesToRuntime a owl:ObjectProperty ;
    rdfs:label "bridges to runtime" ;
    rdfs:domain :BridgeAssertion ;
    rdfs:range :OntologyArtifact .

:bridgesToDeployment a owl:ObjectProperty ;
    rdfs:label "bridges to deployment" ;
    rdfs:domain :BridgeAssertion ;
    rdfs:range :OntologyArtifact .

:bridgesToStakeholderLayer a owl:ObjectProperty ;
    rdfs:label "bridges to stakeholder layer" ;
    rdfs:domain :BridgeAssertion ;
    rdfs:range :OntologyArtifact .

:surfacesConcern a owl:DatatypeProperty ;
    rdfs:label "surfaces concern" ;
    rdfs:domain :BridgeAssertion ;
    rdfs:range xsd:string .

:missingBusinessDomain a owl:DatatypeProperty ;
    rdfs:label "missing business domain" ;
    rdfs:domain :BusinessGap ;
    rdfs:range xsd:string .

:oracleDiscoveryRuntimeBridge a :BridgeAssertion ;
    rdfs:label "OCI Discovery To Semantic Runtime Bridge" ;
    rdfs:comment "Connects OCI discovery concepts to the Oracle RDF runtime layer through the shared Oracle database service and platform narrative." ;
    :bridgesArtifact :oracleOciDiscoveryOntology ;
    :bridgesToRuntime :oracleRdfOntology ;
    :surfacesConcern "OCI database service concepts need a bridge into Oracle semantic runtime and RDF model operation." .

:oracleRuntimeDeploymentBridge a :BridgeAssertion ;
    rdfs:label "Semantic Runtime To Deployment Bridge" ;
    rdfs:comment "Connects Oracle semantic runtime concepts to deployed models and schema-private network targets." ;
    :bridgesArtifact :oracleRdfOntology ;
    :bridgesToDeployment :oracleDeploymentOntology ;
    :surfacesConcern "Oracle semantic storage behavior must be deployable into named networks and transformed ontology artifacts." .

:oracleStakeholderBridge a :BridgeAssertion ;
    rdfs:label "Discovery To Stakeholder Bridge" ;
    rdfs:comment "Connects OCI discovery structure to stakeholder and cloud-positioning concerns without collapsing the layers." ;
    :bridgesArtifact :oracleOciDiscoveryOntology ;
    :bridgesToStakeholderLayer :ociStakeholderOntology ;
    :surfacesConcern "Cloud services and Oracle positioning need a common bridge so stakeholder preferences reference stable service concepts." .

:oracleInfrastructureBridge a :BridgeAssertion ;
    rdfs:label "Runtime To Infrastructure Bridge" ;
    rdfs:comment "Connects Oracle semantic runtime and deployment models to the underlying database substrate." ;
    :bridgesArtifact :oracleRdfOntology, :oracleDeploymentOntology ;
    :bridgesToRuntime :oracleInfrastructureOntology ;
    :surfacesConcern "Runtime and deployment assertions depend on database endpoint, service, user, and tablespace substrate." .

:fusionGap a :BusinessGap ;
    rdfs:label "Fusion Application Gap" ;
    :missingBusinessDomain "Fusion Applications" .

:erpGap a :BusinessGap ;
    rdfs:label "ERP Gap" ;
    :missingBusinessDomain "ERP" .

:hcmGap a :BusinessGap ;
    rdfs:label "HCM Gap" ;
    :missingBusinessDomain "HCM" .

:scmGap a :BusinessGap ;
    rdfs:label "SCM Gap" ;
    :missingBusinessDomain "SCM" .

:cxGap a :BusinessGap ;
    rdfs:label "CX Gap" ;
    :missingBusinessDomain "CX" .

:ebsGap a :BusinessGap ;
    rdfs:label "EBS Gap" ;
    :missingBusinessDomain "E-Business Suite" .
