@prefix : <https://example.com/decision-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

:OracleDiscoveryAdjacencyOntology a owl:Ontology ;
    rdfs:label "Oracle Discovery Adjacency Map" ;
    rdfs:comment "Decision-core overlay mapping the Oracle discovery ontology and its adjacent Oracle-related ontologies in ontology-framework." ;
    owl:versionInfo "0.1.0" ;
    dct:created "2026-04-06"^^xsd:date ;
    owl:imports <./decision-core-core.ttl> .

:OntologyArtifact a owl:Class ;
    rdfs:label "Ontology Artifact" ;
    rdfs:comment "A named ontology or ontology-like artifact included in the Oracle adjacency map." .

:dependsOnOntology a owl:ObjectProperty ;
    rdfs:label "depends on ontology" ;
    rdfs:domain :OntologyArtifact ;
    rdfs:range :OntologyArtifact .

:overlapsWithOntology a owl:ObjectProperty ;
    rdfs:label "overlaps with ontology" ;
    rdfs:domain :OntologyArtifact ;
    rdfs:range :OntologyArtifact .

:adjacentToOntology a owl:ObjectProperty ;
    rdfs:label "adjacent to ontology" ;
    rdfs:domain :OntologyArtifact ;
    rdfs:range :OntologyArtifact .

:fillsLayer a owl:DatatypeProperty ;
    rdfs:label "fills layer" ;
    rdfs:domain :OntologyArtifact ;
    rdfs:range xsd:string .

:coversTopic a owl:DatatypeProperty ;
    rdfs:label "covers topic" ;
    rdfs:domain :OntologyArtifact ;
    rdfs:range xsd:string .

:oracleOciDiscoveryOntology a :OntologyArtifact ;
    rdfs:label "oracle-oci-discovery-ontology.ttl" ;
    :fillsLayer "discovery" ;
    :coversTopic "OCI service taxonomy, learning paths, skills, certifications" .

:ociStakeholderOntology a :OntologyArtifact ;
    rdfs:label "oci.ttl" ;
    :fillsLayer "comparative-stakeholder" ;
    :coversTopic "OCI stakeholder preferences and cross-cloud positioning" .

:oracleRdfOntology a :OntologyArtifact ;
    rdfs:label "oracle_rdf.ttl" ;
    :fillsLayer "semantic-platform" ;
    :coversTopic "Oracle RDF storage models, procedures, constraints, and validation" .

:oracleDeploymentOntology a :OntologyArtifact ;
    rdfs:label "oracle_deployment.ttl" ;
    :fillsLayer "deployment" ;
    :coversTopic "Oracle semantic deployment artifacts, networks, and transformed ontologies" .

:oracleInfrastructureOntology a :OntologyArtifact ;
    rdfs:label "infrastructure/oracle/infrastructure.ttl" ;
    :fillsLayer "runtime-infrastructure" ;
    :coversTopic "Oracle database connectivity, user, and tablespace substrate" .

:oracleOciDiscoveryOntology :overlapsWithOntology :ociStakeholderOntology ;
    :adjacentToOntology :oracleRdfOntology .

:ociStakeholderOntology :overlapsWithOntology :oracleOciDiscoveryOntology ;
    :adjacentToOntology :oracleRdfOntology .

:oracleRdfOntology :dependsOnOntology :oracleInfrastructureOntology ;
    :adjacentToOntology :oracleOciDiscoveryOntology ;
    :adjacentToOntology :ociStakeholderOntology .

:oracleDeploymentOntology :dependsOnOntology :oracleRdfOntology ;
    :dependsOnOntology :oracleInfrastructureOntology .

:oracleInfrastructureOntology :adjacentToOntology :oracleRdfOntology ;
    :adjacentToOntology :oracleDeploymentOntology .
